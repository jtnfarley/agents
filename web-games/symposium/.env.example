# Copy to .env.local and fill in. The key is read on the server only.

# OpenRouter key. Leave it out and set MOCK_AI=1 to run on fixtures.
OPENROUTER_API_KEY=

# Set to 1 to answer every route with fixtures and call no model.
# MOCK_AI=1

# Set to 1 to stop every model call. The routes return "resting".
# AI_DISABLED=1

# One slug per task. Each falls back to MODEL_DEFAULT.
MODEL_DEFAULT=google/gemma-4-31b-it:free
MODEL_TURN=nvidia/nemotron-3-super-120b-a12b:free
MODEL_SUMMARY=nvidia/nemotron-3-super-120b-a12b:free
MODEL_TOPIC_CHECK=google/gemma-4-31b-it:free
MODEL_SUGGEST=google/gemma-4-31b-it:free

# Per-seat overrides for turns. Leave empty to use MODEL_TURN.
# MODEL_SEAT_A=
# MODEL_SEAT_B=

# Retry model, used on bad output, 5xx or 429.
MODEL_FALLBACK=dots-studio/dots-3-note-preview:free

# Slugs that accept response_format (JSON mode), comma separated.
MODEL_JSON_MODE_SLUGS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free

# Slugs that accept reasoning: { enabled: false }. Others get reasoning effort low.
# Hidden reasoning counts against max_tokens, so turn it off where the model allows.
MODEL_REASONING_OFF_SLUGS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free
